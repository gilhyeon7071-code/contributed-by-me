{
  "contract_id": "KOSPI_MCAP_QUARTERLY_C8_CORPORATE_ACTION_ADAPTER",
  "contract_version": "1.0.0",
  "strategy_id": "KOSPI_MCAP_QUARTERLY_V1",
  "lifecycle_contract_id": "KOSPI_MCAP_QUARTERLY_C8_CORPORATE_ACTION_LIFECYCLE",
  "capture_contract_id": "KOSPI_MCAP_QUARTERLY_C8_CORPORATE_ACTION_CAPTURE",
  "source_id": "DART_CORPORATE_ACTIONS_COMPOSITE",
  "endpoints": {
    "corp_code": "https://opendart.fss.or.kr/api/corpCode.xml",
    "disclosure_list": "https://opendart.fss.or.kr/api/list.json",
    "document": "https://opendart.fss.or.kr/api/document.xml"
  },
  "list_request_series": {
    "MERGER_DECISION_HISTORY": {
      "pblntf_ty": "B",
      "pblntf_detail_ty": "B001",
      "accepted_report_name_fragments": ["회사합병결정"]
    },
    "MERGER_COMPLETION_HISTORY": {
      "pblntf_ty": "E",
      "pblntf_detail_ty": "E003",
      "accepted_report_name_fragments": ["합병등종료보고서"]
    }
  },
  "fixed_list_parameters": {
    "last_reprt_at": "N",
    "sort": "date",
    "sort_mth": "asc",
    "page_count": "100"
  },
  "success_statuses": ["000", "013"],
  "no_data_status": "013",
  "required_list_row_fields": [
    "corp_code",
    "stock_code",
    "report_nm",
    "rcept_no",
    "rcept_dt",
    "rm"
  ],
  "document_rules": {
    "revision_report_prefixes": ["[기재정정]", "[첨부정정]", "[첨부추가]"],
    "cancellation_phrases": ["합병결정 취소", "합병계약 해제", "합병계약 해지"],
    "actual_effective_date_labels": ["합병기일"],
    "explicit_lineage_patterns": [
      "rcpNo[^0-9]{0,8}([0-9]{14})",
      "rcept_no[^0-9]{0,8}([0-9]{14})",
      "접수번호[^0-9]{0,8}([0-9]{14})"
    ],
    "date_patterns": [
      "([0-9]{4})[.년/-][ ]*([0-9]{1,2})[.월/-][ ]*([0-9]{1,2})"
    ],
    "lineage_authority": "ORIGINAL_DOCUMENT_EXPLICIT_REFERENCE"
  },
  "completeness_rules": {
    "base_code_mapping": "exact one-to-one stock_code to corp_code",
    "required_series_per_corp_code": [
      "MERGER_DECISION_HISTORY",
      "MERGER_COMPLETION_HISTORY"
    ],
    "required_pages": "every page from 1 through total_page for every series and corp_code",
    "required_documents": "every accepted merger disclosure receipt has one non-empty original document package",
    "empty_history": "status 013 is valid only as a hashed response to an exact per-corp series request"
  },
  "live_probe": {
    "scope": "ONE_CODE_CONNECTIVITY_ONLY",
    "maximum_query_days": 31,
    "raw_persistence": false,
    "full_capture_evidence": false
  },
  "publication_rule": "adapter output is read-only and cannot publish acquisition evidence, canonical, M2, candidates, targets, or orders",
  "execution_permissions": {
    "network_collection_allowed": false,
    "acquisition_evidence_publish_allowed": false,
    "canonical_publish_allowed": false,
    "m2_allowed": false,
    "candidate_selection_allowed": false,
    "orders_allowed": false
  }
}
